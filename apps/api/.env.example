NODE_ENV=development
PORT=4000
APP_NAME=shopkit-api
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API (the admin dashboard).
ALLOWED_ORIGINS=http://localhost:3010

DATABASE_HOST=localhost
DATABASE_PORT=5442
DATABASE_USER=shopkit
DATABASE_PASSWORD=shopkit
DATABASE_NAME=shopkit
DATABASE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_USER=
REDIS_PASSWORD=

JWT_SECRET=change-me-to-a-long-random-string

# Stores are served at <subdomain>.<STOREFRONT_ROOT_DOMAIN> (port is ignored when matching).
STOREFRONT_ROOT_DOMAIN=localhost

# AI provider for store generation. Only "mock" exists today.
AI_PROVIDER=mock

# Image uploads. "local" saves to UPLOADS_DIR and serves them at /uploads (development only).
# "s3" uploads through @arhaminnovations/nestjs-aws; STORAGE_PUBLIC_URL can point at a CDN.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
STORAGE_PUBLIC_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=

# Platform Razorpay account: charges sellers for plans and AI credits.
# Sellers' own store payments use the keys each seller enters in Settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 64 hex chars (openssl rand -hex 32). Encrypts sellers' Razorpay secrets. Required in production.
ENCRYPTION_KEY=

# Public URL of this API (webhook URLs and invoice links shown to sellers/buyers).
API_PUBLIC_URL=http://localhost:4000
# Used to build store links in notifications: <protocol>://<subdomain>.<root><:port>
STOREFRONT_PROTOCOL=http
STOREFRONT_PORT=3020
# Shared secret the storefront server sends so the API trusts its forwarded buyer IP. Required in production.
STOREFRONT_API_KEY=dev-storefront-key
# Sellers point their custom domain's CNAME here. Defaults to stores.<STOREFRONT_ROOT_DOMAIN>.
CUSTOM_DOMAIN_TARGET=
# Express "trust proxy" setting when running behind a load balancer (e.g. 1).
TRUST_PROXY=

# Order emails / WhatsApp through notifyr. Left empty, messages are only logged.
NOTIFYR_URL=
NOTIFYR_API_KEY=
NOTIFYR_FROM_EMAIL=orders@shopkit.in
NOTIFYR_FROM_NAME=Shopkit
