    "@arhaminnovations/nestjs-identity": "^1.0.1",
    "@arhaminnovations/nestjs-payment": "^1.0.2",
    "@arhaminnovations/nestjs-pino-logger": "^1.0.1",
    "@arhaminnovations/nestjs-redis": "^1.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
