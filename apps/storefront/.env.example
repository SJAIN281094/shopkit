API_GRAPHQL_URL=http://localhost:4000/graphql

# Admin app origin, allowed to refresh design previews
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3010

# Browser-facing API origin, used for invoice links
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Shared secret with the API (STOREFRONT_API_KEY there); lets the API rate-limit orders by the buyer's IP
STOREFRONT_API_KEY=dev-storefront-key
